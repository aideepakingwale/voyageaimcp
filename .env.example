# ══════════════════════════════════════════════════════════
# VoyageAI — Environment Configuration
# Copy to .env and fill in your keys
# ══════════════════════════════════════════════════════════

# ── LLM PROVIDERS (zero-cost waterfall) ──────────────────

# PROVIDER 1: Groq — FREE, fastest (~500 tok/s)
# Signup: console.groq.com (no credit card)
# Free tier: 14,400 req/day, 500,000 tokens/day
GROQ_API_KEY=

# PROVIDER 2: Google Gemini — FREE
# Signup: aistudio.google.com (Google account)
# Free tier: 15 req/min, 1M tokens/day
GEMINI_API_KEY=

# PROVIDER 3: Anthropic Claude — PAID fallback (optional)
# Only fires if Groq + Gemini both fail
ANTHROPIC_API_KEY=

# ── FLIGHT + HOTEL + EXPERIENCES ─────────────────────────
# Amadeus — FREE sandbox (real flight & hotel data)
# Signup: developers.amadeus.com (no credit card for sandbox)
# Sandbox: real airline data, test fares — perfect for demos
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ── WEATHER ───────────────────────────────────────────────
# OpenWeatherMap — FREE (1000 calls/day)
# Signup: openweathermap.org/api → "Current Weather Data" plan
OPENWEATHER_API_KEY=

# ── CURRENCY EXCHANGE ─────────────────────────────────────
# ExchangeRate-API — FREE (1,500 req/month)
# Signup: exchangerate-api.com (email only, no credit card)
EXCHANGERATE_API_KEY=

# ── DISTANCE & ROUTING ───────────────────────────────────
# OpenRouteService — FREE (2,000 req/day, no credit card)
# Signup: openrouteservice.org → Dashboard → API Key
OPENROUTESERVICE_API_KEY=

# ══════════════════════════════════════════════════════════
# DATA STRATEGY:
#   Flights:     Amadeus live → intelligent mock (date-aware pricing)
#   Hotels:      Amadeus live → curated realistic mock
#   Experiences: Amadeus live → curated per-city catalogue
#   Weather:     OpenWeatherMap live → monthly climate averages
#   Currency:    ExchangeRate-API live → static indicative rates
#   Maps:        OpenRouteService live → haversine calculation
#   Cars:        Location-aware pricing calculation (no free API)
#   Visa:        Curated requirements table + REST Countries
#   Loyalty:     SQLite mock (intentional — demo customer data)
# ══════════════════════════════════════════════════════════
